<resources>
    <string name="app_name">记账本</string>

    <!-- 列表页。卡片跟着所选日期走，标签用通用文案，不写死「今日」 -->
    <string name="summary_income">收入</string>
    <string name="summary_expense">支出</string>
    <string name="summary_balance">结余</string>
    <!-- 日期栏。%1$s 是月日（10-09），%2$s 是今天/昨天/前天 -->
    <string name="day_label">%1$s %2$s</string>
    <!-- 空态。%1$s 是所选日期的说法：今天 / 昨天 / 前天 / 10-09 -->
    <string name="empty_records_day">%1$s 还没有记录\n点右下角 + 记一笔</string>
    <!-- 金额前缀。收入恒为 +、支出恒为 -，结余按正负取其一 -->
    <string name="amount_positive">+%1$s</string>
    <string name="amount_negative">-%1$s</string>
    <string name="action_stats">统计</string>
    <string name="action_add">新增记录</string>
    <string name="action_prev_day">前一天</string>
    <string name="action_next_day">后一天</string>
    <string name="action_pick_day">选择日期</string>
    <string name="cd_delete_record">删除这条记录</string>
    <string name="deleted">已删除</string>

    <!-- 录入页 -->
    <string name="title_add">新增记录</string>
    <string name="title_edit">编辑记录</string>
    <string name="type_expense">支出</string>
    <string name="type_income">收入</string>
    <string name="label_amount">金额</string>
    <string name="hint_amount">0.00</string>
    <string name="label_remark">备注</string>
    <string name="hint_remark">可选，例如：午餐</string>
    <string name="label_time">时间</string>
    <string name="action_pick_datetime">选择日期和时间</string>
    <string name="date_today">今天</string>
    <string name="date_yesterday">昨天</string>
    <string name="date_before_yesterday">前天</string>
    <string name="date_custom">自选</string>
    <string name="action_save">保存</string>
    <string name="action_delete">删除</string>
    <string name="action_cancel">取消</string>
    <string name="saved_expense">已记录支出 %1$s</string>
    <string name="saved_income">已记录收入 %1$s</string>
    <string name="saved_updated">已保存 %1$s</string>

    <!-- 删除确认 -->
    <string name="delete_confirm_title">删除这条记录？</string>
    <string name="delete_confirm_message">删除后无法恢复。</string>

    <!--
      备份。账本只存在本机，重装、换机之前得先自己导一份出来，
      所以导出和导入是这件应用的「保险绳」，文案要把不可撤销讲清楚。
    -->
    <string name="action_export">导出备份</string>
    <string name="action_import">导入备份</string>
    <string name="action_import_confirm">覆盖导入</string>
    <!-- 建议的文件名，%1$s 是导出日期（2026-10-12），攒了几份备份时才分得清 -->
    <string name="backup_file_name">bookkeeping-%1$s.json</string>
    <string name="backup_exported">已导出 %1$d 条记录</string>
    <string name="backup_imported">已导入 %1$d 条记录</string>
    <string name="backup_import_confirm_title">导入备份？</string>
    <!-- %1$s 是文件名，%2$s 是备份时间，%3$d 是备份里的记录条数 -->
    <string name="backup_import_confirm_message">导入会清空账本里现有的全部记录，换成这份备份里的内容，且无法撤销。\n\n文件：%1$s\n备份时间：%2$s\n共 %3$d 条记录</string>
    <!-- 空备份会把账本清空，是最该说清楚的一种情况 -->
    <string name="backup_import_confirm_message_empty">这份备份里没有任何记录。导入会清空账本，且无法撤销。\n\n文件：%1$s\n备份时间：%2$s</string>
    <string name="backup_error_malformed">这个文件不是完整的备份文件</string>
    <string name="backup_error_not_backup">这个文件不是本应用导出的备份</string>
    <string name="backup_error_newer_version">备份的版本比当前应用新，请先升级应用</string>
    <!-- %1$d 是出问题的记录序号，从 1 起 -->
    <string name="backup_error_bad_record">备份里第 %1$d 条记录不合法，已放弃导入</string>
    <string name="backup_error_too_large">备份文件过大，已放弃导入</string>
    <string name="backup_error_io">读写备份文件失败</string>
    <string name="backup_error_no_picker">没有可用的文件选择器</string>

    <!-- 错误提示 -->
    <string name="error_amount_invalid">请输入大于 0 的金额</string>
    <string name="error_save_failed">保存失败，请重试</string>
    <string name="error_operation_failed">操作失败，请重试</string>
    <string name="error_record_missing">记录不存在或已被删除</string>
    <string name="error_future_day">不能选择未来的日期</string>

    <!-- 统计页。粒度只有天/月/年，日历一页一格按粒度放大 -->
    <string name="period_day">天</string>
    <string name="period_month">月</string>
    <string name="period_year">年</string>
    <string name="action_prev_period">上一个周期</string>
    <string name="action_next_period">下一个周期</string>
    <string name="stats_total_income">总收入</string>
    <string name="stats_total_expense">总支出</string>
    <string name="stats_balance">结余</string>
    <!-- 空态。%1$s 是当前页的区间文案，如 2026-10 -->
    <string name="empty_stats">%1$s 还没有记录</string>
    <!-- 日期格子的读屏文案。%1$s 是日期，%2$s 是当天结余 -->
    <string name="cd_day_cell">%1$s，结余 %2$s</string>

    <!-- 日历表头，周一起算 -->
    <string-array name="calendar_weekdays">
        <item>一</item>
        <item>二</item>
        <item>三</item>
        <item>四</item>
        <item>五</item>
        <item>六</item>
        <item>日</item>
    </string-array>
</resources>
